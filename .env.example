# ══════════════════════════════════════════════════════
#  Instagram → Telegram Repost Bot — Environment Config
#  Copy this file to .env and fill in your values
# ══════════════════════════════════════════════════════

# ── Instagram ──────────────────────────────────────────
# NOTE: No Instagram login needed! Only public accounts are scraped.

# Comma-separated list of PUBLIC IG accounts to monitor
IG_TARGET_ACCOUNTS=natgeo,nasa

# ── Telegram ───────────────────────────────────────────
# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your channel username (with @) or numeric ID (-100xxxxxxxxx)
TELEGRAM_CHANNEL_ID=@your_channel

# ── Scheduler ──────────────────────────────────────────
# How often to check for new posts (in hours)
CHECK_INTERVAL_HOURS=2

# How far back to look for posts (in hours)
LOOKBACK_HOURS=24

# ── Database ───────────────────────────────────────────
DB_PATH=seen_posts.db

# ── Rate limiting ──────────────────────────────────────
# Seconds between Telegram messages
TELEGRAM_SEND_DELAY=2

# Seconds between Instagram requests (be respectful to avoid rate limits)
IG_REQUEST_DELAY=3
